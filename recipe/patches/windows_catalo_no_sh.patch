From: krande
Subject: Windows: catalo/wscript evaluates LD_PRELOAD with 'sh -c'

Since 18.1.9, _eval_shell_var runs 'sh -c' to expand "${VAR:-default}",
which fails with FileNotFoundError on Windows (no sh). LD_PRELOAD is
unused there: return an empty value.
---
diff -ru a/catalo/wscript b/catalo/wscript
--- a/catalo/wscript
+++ b/catalo/wscript
@@ -79,6 +79,9 @@ def pre_build_catalo(self):
 def _eval_shell_var(var_expr: str | list[str]):
     """Evaluate an environment variable using the shell (to support "${VAR:-default}")."""
     var_expr = ":".join(Utils.to_list(var_expr))
+    if platform.system() == "Windows":
+        # no 'sh' on Windows, and LD_PRELOAD is meaningless there
+        return ""
     var_value = subprocess.run(
         ["sh", "-c", f'printf "%s" "{var_expr}"'], capture_output=True, text=True
     ).stdout
