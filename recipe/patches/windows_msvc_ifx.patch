+    self.remove_flags("FCFLAGS", "^/O[0-9a-z]")
+    flags = ["/Od", "/Zi", "/debug:full", "/traceback"]
+    flags += Utils.to_list(self.env["FCFLAGS_ASTER_DEBUG"])
+    self.env.append_unique("FCFLAGS", flags)
+    self.end_msg(flags)
